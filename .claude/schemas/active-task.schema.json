{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NyxVoice Active Task Contract",
  "type": "object",
  "required": [
    "taskId",
    "phaseId",
    "title",
    "objective",
    "status",
    "createdAt",
    "updatedAt",
    "approvedByJudge",
    "scope",
    "allowedPaths",
    "readOnlyPaths",
    "forbiddenPaths",
    "allowedCommandFamilies",
    "forbiddenCommandFamilies",
    "acceptanceCriteria",
    "requiredTests",
    "requiredReviews",
    "requiredEvidence",
    "risks",
    "rollbackPlan",
    "dependencies",
    "humanApprovals",
    "maxRepairCycles"
  ],
  "properties": {
    "taskId": { "type": "string", "pattern": "^FV-P[0-9]{2}-T[0-9]{3}$" },
    "phaseId": { "type": "string", "pattern": "^FV-P[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "under-review", "approved", "implementing", "verifying", "reviewing", "rework", "blocked", "completed"]
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "expiresAt": { "type": "string" },
    "approvedByJudge": { "type": "boolean" },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowedPaths": { "type": "array", "items": { "type": "string" } },
    "readOnlyPaths": { "type": "array", "items": { "type": "string" } },
    "forbiddenPaths": { "type": "array", "items": { "type": "string" } },
    "allowedCommandFamilies": { "type": "array", "items": { "type": "string" } },
    "forbiddenCommandFamilies": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
    "requiredTests": { "type": "array", "items": { "type": "string" } },
    "requiredReviews": { "type": "array", "items": { "type": "string" } },
    "requiredEvidence": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "rollbackPlan": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "humanApprovals": { "type": "array", "items": { "type": "string" } },
    "maxRepairCycles": { "type": "integer", "minimum": 0, "maximum": 10 },
    "verification": { "type": "object" },
    "openFindings": { "type": "array" }
  },
  "additionalProperties": true
}
