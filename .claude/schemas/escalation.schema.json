  "properties": {
    "taskId": { "type": "string" },
    "operation": { "type": "string" },
    "category": { "type": "string", "pattern": "^E-[0-9]{3}$" },
    "whyJudgeCannotDecide": { "type": "string" },
    "options": { "type": "array", "items": { "type": "string" } },
    "recommendedOption": { "type": "string" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "refusalConsequence": { "type": "string" },
    "singleQuestion": { "type": "string" }
  },
  "additionalProperties": false
}
