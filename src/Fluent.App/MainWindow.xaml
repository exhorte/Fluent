<Window x:Class="Fluent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Fluent.App.Views"
        mc:Ignorable="d"
        Title="Fluent"
        Height="640"
        Width="1040"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Nyx.WindowBrush}"
        Foreground="{StaticResource Nyx.PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Nyx.WindowBrush}"
                BorderBrush="{StaticResource Nyx.BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Control Width="24"
                             Height="24"
                             Focusable="False"
                             Template="{StaticResource Nyx.LogoMarkTemplate}" />
                    <TextBlock Text="Fluent"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Nyx.SidebarBrush}"
                    BorderBrush="{StaticResource Nyx.BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,22,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="NavSectionLabel"
                                   Text="{Binding [nav.section], Source={StaticResource Loc}}"
                                   Margin="10,0,0,10"
                                   Style="{StaticResource Nyx.LabelTextStyle}" />

                        <Button Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Home"
                                AutomationProperties.HelpText="Afficher l'accueil local"
                                TabIndex="0"
                                Click="OnOverviewNavigationClick">
                            <Border x:Name="OverviewNavigationSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌂"
                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavHomeLabel"
                                               Grid.Column="1"
                                               Text="{Binding [nav.home], Source={StaticResource Loc}}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Margin="0,14,0,0"
                                Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Historique"
                                AutomationProperties.HelpText="Ouvrir l'historique local des dictées"
                                TabIndex="1"
                                Click="OnHistoryNavigationClick">
                            <Border x:Name="HistoryNavigationSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◷"
                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavHistoryLabel"
                                               Grid.Column="1"
                                               Text="{Binding [nav.history], Source={StaticResource Loc}}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="HistoryNavigationStatusText"
                                               Grid.Column="2"
                                               Text="OFF"
                                               Foreground="{StaticResource Nyx.MutedTextBrush}"
                                               FontSize="8" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Margin="0,5,0,0"
                                Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Dictionnaire"
                                AutomationProperties.HelpText="Gérer le dictionnaire personnel local"
                                TabIndex="2"
                                Click="OnDictionaryNavigationClick">
                            <Border x:Name="DictionaryNavigationSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Aa"
                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="NavDictionaryLabel"
                                               Grid.Column="1"
                                               Text="{Binding [nav.dictionary], Source={StaticResource Loc}}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DictionaryNavigationStatusText"
                                               Grid.Column="2"
                                               Text="CHARGEMENT"
                                               Foreground="{StaticResource Nyx.MutedTextBrush}"
                                               FontSize="8" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Margin="0,5,0,0"
                                Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Subscription"
                                AutomationProperties.HelpText="Gérer l'abonnement et passer à Pro"
                                TabIndex="3"
                                Click="OnSubscriptionNavigationClick">
                            <Border x:Name="SubscriptionNavigationSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◇"
                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavSubscriptionLabel"
                                               Grid.Column="1"
                                               Text="{Binding [nav.subscription], Source={StaticResource Loc}}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="SubscriptionNavigationStatusText"
                                               Grid.Column="2"
                                               Text="GRATUIT"
                                               Foreground="{StaticResource Nyx.MutedTextBrush}"
                                               FontSize="8"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button Margin="0,14,0,0"
                                Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Paramètres"
                                AutomationProperties.HelpText="Ouvrir les paramètres locaux"
                                TabIndex="4"
                                Click="OnSettingsNavigationClick">
                            <Border x:Name="SettingsNavigationSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚙"
                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavSettingsLabel"
                                               Grid.Column="1"
                                               Text="{Binding [nav.settings], Source={StaticResource Loc}}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource Nyx.NavButtonStyle}"
                                AutomationProperties.Name="Profils"
                                AutomationProperties.HelpText="Ouvrir le profil et les options de réécriture"
                                TabIndex="5"
                                Click="OnProfileChipClick">
                            <Border x:Name="ProfileChipSurface"
                                    Style="{StaticResource Nyx.NavSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="8"
                                            Background="{StaticResource Nyx.SelectedBrush}"
                                            BorderBrush="{StaticResource Nyx.BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="ProfileAvatarText"
                                                   Text="•"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock x:Name="ProfileNameText"
                                               Grid.Column="1"
                                               Text="Utilisateur local"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource Nyx.NavButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="12,4,0,0"
                                AutomationProperties.Name="Upgrade plan"
                                AutomationProperties.HelpText="Passer à Pro"
                                TabIndex="6"
                                Click="OnUpgradeNavigationClick">
                            <TextBlock Text="{Binding [nav.upgrade], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                       TextDecorations="Underline"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="OverviewPage"
                          Grid.Column="1"
                          AutomationProperties.Name="Page Home"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,26,28,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding [home.title], Source={StaticResource Loc}}"
                                   Style="{StaticResource Nyx.PageTitleTextStyle}" />
                        <TextBlock Text="{Binding [home.subtitle], Source={StaticResource Loc}}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource Nyx.BodyTextStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [home.card.state], Source={StaticResource Loc}}" Style="{StaticResource Nyx.LabelTextStyle}" />
                                <TextBlock x:Name="DictationStateText"
                                           Text="Idle"
                                           Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Nyx.MetricTextStyle}" />
                                <TextBlock Text="{Binding [home.state.desc], Source={StaticResource Loc}}"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [home.card.shortcut], Source={StaticResource Loc}}" Style="{StaticResource Nyx.LabelTextStyle}" />
                                <TextBlock Text="{Binding [home.shortcut.value], Source={StaticResource Loc}}"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource Nyx.MetricTextStyle}"
                                           FontSize="17" />
                                <TextBlock x:Name="HotkeyStatusText"
                                           Text="Initialisation"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [home.card.engine], Source={StaticResource Loc}}" Style="{StaticResource Nyx.LabelTextStyle}" />
                                <TextBlock Text="Base Q8"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource Nyx.MetricTextStyle}" />
                                <TextBlock Text="{Binding [home.engine.desc], Source={StaticResource Loc}}"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [home.card.privacy], Source={StaticResource Loc}}" Style="{StaticResource Nyx.LabelTextStyle}" />
                                <TextBlock Text="{Binding [home.privacy.value], Source={StaticResource Loc}}"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource Nyx.MetricTextStyle}"
                                           FontSize="17" />
                                <TextBlock Text="{Binding [home.privacy.desc], Source={StaticResource Loc}}"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [home.lastActivity], Source={StaticResource Loc}}"
                                               Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                    <Border Grid.Column="1"
                                            Background="#1430D1CB"
                                            BorderBrush="#4030D1CB"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,3">
                                        <TextBlock Text="LOCAL"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Nyx.CyanBrush}" />
                                    </Border>
                                </Grid>

                                <Border Margin="0,16,0,0"
                                        Background="{StaticResource Nyx.SelectedBrush}"
                                        BorderBrush="{StaticResource Nyx.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="14">
                                    <TextBlock x:Name="LastResultText"
                                               Text="{Binding [home.lastResult.default], Source={StaticResource Loc}}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Style="{StaticResource Nyx.BodyTextStyle}"
                                               Foreground="{StaticResource Nyx.PrimaryTextBrush}" />
                                </Border>

                                <TextBlock Text="{Binding [home.insertion.note], Source={StaticResource Loc}}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Nyx.DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding [home.target.title], Source={StaticResource Loc}}"
                                           Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                <TextBlock x:Name="TargetStatusText"
                                           Text="{Binding [home.target.none], Source={StaticResource Loc}}"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Style="{StaticResource Nyx.BodyTextStyle}" />
                                <Border Margin="0,18,0,0"
                                        Background="#1265D6A6"
                                        BorderBrush="#3565D6A6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7">
                                    <TextBlock Text="{Binding [home.target.note], Source={StaticResource Loc}}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Foreground="{StaticResource Nyx.SuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="6" Style="{StaticResource Nyx.DashboardCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [home.foundations.title], Source={StaticResource Loc}}"
                                           Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                <TextBlock Text="{Binding [home.foundations.subtitle], Source={StaticResource Loc}}"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource Nyx.BodyTextStyle}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Border Margin="0,0,8,0" Background="{StaticResource Nyx.SelectedBrush}" CornerRadius="7" Padding="9,5">
                                    <TextBlock x:Name="ProfileSummaryText"
                                               Text="Profil · Français professionnel"
                                               FontSize="9"
                                               Foreground="{StaticResource Nyx.SecondaryTextBrush}" />
                                </Border>
                                <Border Margin="0,0,8,0" Background="{StaticResource Nyx.SelectedBrush}" CornerRadius="7" Padding="9,5">
                                    <TextBlock x:Name="DictionarySummaryText"
                                               Text="Dictionnaire · chargement"
                                               FontSize="9"
                                               Foreground="{StaticResource Nyx.SecondaryTextBrush}" />
                                </Border>
                                <Border Margin="0,0,8,0" Background="{StaticResource Nyx.SelectedBrush}" CornerRadius="7" Padding="9,5">
                                    <TextBlock x:Name="AuthenticationSummaryText"
                                               Text="Compte · vérification"
                                               FontSize="9"
                                               Foreground="{StaticResource Nyx.SecondaryTextBrush}" />
                                </Border>
                                <Border Margin="0,0,8,0" Background="{StaticResource Nyx.SelectedBrush}" CornerRadius="7" Padding="9,5">
                                    <TextBlock x:Name="CloudSummaryText"
                                               Text="Cloud · local"
                                               FontSize="9"
                                               Foreground="{StaticResource Nyx.SecondaryTextBrush}" />
                                </Border>
                                <Border Background="{StaticResource Nyx.SelectedBrush}" CornerRadius="7" Padding="9,5">
                                    <TextBlock Text="Historique · local opt-in" FontSize="9" Foreground="{StaticResource Nyx.SecondaryTextBrush}" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <views:DictionaryPage x:Name="DictionaryPage"
                                  Grid.Column="1"
                                  AutomationProperties.Name="Page Dictionnaire"
                                  Visibility="Collapsed" />

            <views:ProfilesPage x:Name="ProfilesPage"
                                Grid.Column="1"
                                AutomationProperties.Name="Page Profils"
                                Visibility="Collapsed" />

            <views:HistoryPage x:Name="HistoryPage"
                               Grid.Column="1"
                               AutomationProperties.Name="Page Historique"
                               Visibility="Collapsed" />

            <views:SettingsPage x:Name="SettingsPage"
                                Grid.Column="1"
                                AutomationProperties.Name="Page Paramètres"
                                Visibility="Collapsed" />

            <views:SubscriptionPage x:Name="SubscriptionPage"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Page Abonnement"
                                    Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
