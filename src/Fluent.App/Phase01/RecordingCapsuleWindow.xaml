<Window x:Class="Fluent.App.Phase01.RecordingCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="126"
        Height="34"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════════════
             Brushes
             ═══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Capsule.IdleStrokeBrush" Color="#A6A6A6" />
        <SolidColorBrush x:Key="Capsule.IdleFillBrush" Color="#B8000000" />
        <SolidColorBrush x:Key="Capsule.ActiveBackgroundBrush" Color="#DC050505" />
        <SolidColorBrush x:Key="Capsule.ActiveBorderBrush" Color="#454545" />
        <SolidColorBrush x:Key="Capsule.CancelBackgroundBrush" Color="#353535" />
        <SolidColorBrush x:Key="Capsule.CancelBorderBrush" Color="#555555" />
        <SolidColorBrush x:Key="Capsule.CancelIconBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="Capsule.PasteBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="Capsule.PasteBorderBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Capsule.PasteIconBrush" Color="#111111" />
        <SolidColorBrush x:Key="Capsule.WaveBrush" Color="#F5F5F6" />
        <SolidColorBrush x:Key="Capsule.ProcessingDotBrush" Color="#9A9AA0" />

        <!-- ═══════════════════════════════════════════════════════════
             Idle circle style
             ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="IdleCircleStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stroke" Value="{StaticResource Capsule.IdleStrokeBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="{StaticResource Capsule.IdleFillBrush}" />
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             Cancel button style (circular)
             ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{StaticResource Capsule.CancelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Capsule.CancelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Width="22" Height="22"
                                CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="cancelIcon"
                                  Data="M8,8 L14,14 M14,8 L8,14"
                                  Stroke="{StaticResource Capsule.CancelIconBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             Paste button style (circular)
             ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="PasteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{StaticResource Capsule.PasteBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Capsule.PasteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Width="22" Height="22"
                                CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- Clipboard icon: rounded rect + paper -->
                            <Path Data="M8.5,7.5 L11,7.5 L11,6 L13.5,8.5 L11,11 L11,9.5 L8.5,9.5 Z M7.5,6 L7.5,15 L13,15 L13,11 L12,11 L12,14 L8.5,14 L8.5,7 L10,7 L10,6 L7.5,6 Z"
                                  Fill="{StaticResource Capsule.PasteIconBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             Waveform bar style
             ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="WaveformBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="2" />
            <Setter Property="Fill" Value="{StaticResource Capsule.WaveBrush}" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             Animations — Recording waveform
             ═══════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="RecordingWaveStoryboard" RepeatBehavior="Forever">
            <!-- 13 bars with staggered timing for natural speech-like movement -->
            <DoubleAnimation Storyboard.TargetName="WfBar01" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.25" To="1.0" Duration="0:0:0.32" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WfBar02" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.35" To="1.0" Duration="0:0:0.38" AutoReverse="True" BeginTime="0:0:0.04" />
            <DoubleAnimation Storyboard.TargetName="WfBar03" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.20" To="1.0" Duration="0:0:0.29" AutoReverse="True" BeginTime="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="WfBar04" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.45" To="1.0" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.02" />
            <DoubleAnimation Storyboard.TargetName="WfBar05" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.30" To="1.0" Duration="0:0:0.41" AutoReverse="True" BeginTime="0:0:0.11" />
            <DoubleAnimation Storyboard.TargetName="WfBar06" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.55" To="1.0" Duration="0:0:0.26" AutoReverse="True" BeginTime="0:0:0.06" />
            <DoubleAnimation Storyboard.TargetName="WfBar07" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.20" To="1.0" Duration="0:0:0.37" AutoReverse="True" BeginTime="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="WfBar08" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.40" To="1.0" Duration="0:0:0.33" AutoReverse="True" BeginTime="0:0:0.09" />
            <DoubleAnimation Storyboard.TargetName="WfBar09" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.30" To="1.0" Duration="0:0:0.44" AutoReverse="True" BeginTime="0:0:0.03" />
            <DoubleAnimation Storyboard.TargetName="WfBar10" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.50" To="1.0" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0.13" />
            <DoubleAnimation Storyboard.TargetName="WfBar11" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.25" To="1.0" Duration="0:0:0.36" AutoReverse="True" BeginTime="0:0:0.07" />
            <DoubleAnimation Storyboard.TargetName="WfBar12" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.35" To="1.0" Duration="0:0:0.31" AutoReverse="True" BeginTime="0:0:0.17" />
            <DoubleAnimation Storyboard.TargetName="WfBar13" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.45" To="1.0" Duration="0:0:0.40" AutoReverse="True" BeginTime="0:0:0.10" />
        </Storyboard>

        <!-- ═══════════════════════════════════════════════════════════
             Animations — Processing pulse (slow breathing bars)
             ═══════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="ProcessingPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WfBar01" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.40" To="0.70" Duration="0:0:0.80" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WfBar03" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.45" To="0.75" Duration="0:0:0.90" AutoReverse="True" BeginTime="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="WfBar05" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.35" To="0.65" Duration="0:0:0.85" AutoReverse="True" BeginTime="0:0:0.30" />
            <DoubleAnimation Storyboard.TargetName="WfBar07" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.40" To="0.70" Duration="0:0:0.95" AutoReverse="True" BeginTime="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="WfBar09" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.45" To="0.75" Duration="0:0:0.80" AutoReverse="True" BeginTime="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="WfBar11" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.35" To="0.65" Duration="0:0:0.92" AutoReverse="True" BeginTime="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="WfBar13" Storyboard.TargetProperty="(Rectangle.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.40" To="0.70" Duration="0:0:0.87" AutoReverse="True" BeginTime="0:0:0.18" />
        </Storyboard>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         Root container
         ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- ── Idle content: three discrete circles ────────────────── -->
        <Grid x:Name="IdleContent" Visibility="Visible">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Style="{StaticResource IdleCircleStyle}" Margin="0,0,6,0" />
                <Ellipse Style="{StaticResource IdleCircleStyle}" Margin="0,0,6,0" />
                <Ellipse Style="{StaticResource IdleCircleStyle}" />
            </StackPanel>
        </Grid>

        <!-- ── Active content: compact pill ────────────────────────── -->
        <Grid x:Name="ActiveContent" Visibility="Collapsed">
            <Border Background="{StaticResource Capsule.ActiveBackgroundBrush}"
                    BorderBrush="{StaticResource Capsule.ActiveBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="17"
                    Padding="5,0">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>

                    <!-- Cancel button -->
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Style="{StaticResource CancelButtonStyle}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            AutomationProperties.Name="Cancel dictation" />

                    <!-- Waveform -->
                    <ItemsControl x:Name="WaveformBars"
                                  Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Style="{StaticResource WaveformBarStyle}"
                                           Height="14"
                                           Margin="0.75,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.3" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <Rectangle x:Name="WfBar01" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar01Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar02" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar02Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar03" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar03Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar04" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar04Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar05" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar05Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar06" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar06Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar07" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar07Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar08" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar08Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar09" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar09Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar10" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar10Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar11" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar11Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar12" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar12Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="WfBar13" Style="{StaticResource WaveformBarStyle}" Height="14" Margin="0.75,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="WfBar13Scale" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                    </ItemsControl>

                    <!-- Paste button -->
                    <Button x:Name="PasteButton"
                            Grid.Column="2"
                            Style="{StaticResource PasteButtonStyle}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            AutomationProperties.Name="Paste transcription" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
