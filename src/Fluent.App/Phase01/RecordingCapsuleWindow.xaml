<Window x:Class="Fluent.App.Phase01.RecordingCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="130"
        Height="40"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Cursor="SizeAll"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Storyboard x:Key="RecordingWaveStoryboard">
            <DoubleAnimation Storyboard.TargetName="WaveScale1"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1"
                             Duration="0:0:0.31"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale2"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.45" To="1"
                             BeginTime="0:0:0.07"
                             Duration="0:0:0.39"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale3"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1"
                             BeginTime="0:0:0.14"
                             Duration="0:0:0.34"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale4"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.55" To="1"
                             BeginTime="0:0:0.03"
                             Duration="0:0:0.27"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale5"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1"
                             BeginTime="0:0:0.11"
                             Duration="0:0:0.43"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale6"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.45" To="1"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.32"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="WaveScale7"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1"
                             BeginTime="0:0:0.08"
                             Duration="0:0:0.37"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>

        <Storyboard x:Key="ProcessingPulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="ProcessingDot1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1"
                             Duration="0:0:0.45"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ProcessingDot2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1"
                             BeginTime="0:0:0.15"
                             Duration="0:0:0.45"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ProcessingDot3"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1"
                             BeginTime="0:0:0.3"
                             Duration="0:0:0.45"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Border Margin="2"
            Background="#F207080C"
            BorderBrush="{StaticResource Nyx.CapsuleBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="8,5">
        <Grid>
            <Grid x:Name="IdleContent" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Control Width="24"
                         Height="24"
                         Focusable="False"
                         Template="{StaticResource Nyx.LogoMarkTemplate}" />
                <TextBlock Grid.Column="2"
                           Text="Fluent"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Grid>

            <Grid x:Name="RecordingContent"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Control Width="26"
                         Height="26"
                         Focusable="False"
                         Template="{StaticResource Nyx.LogoMarkTemplate}" />
                <Border Grid.Column="2"
                        Height="19"
                        VerticalAlignment="Center"
                        Background="{StaticResource Nyx.BorderBrush}" />
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="3" Height="13" Margin="0,0,2,0" CornerRadius="1.5" Background="#D5D7DC" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale1" ScaleY="0.3" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="9" Margin="0,0,2,0" CornerRadius="1.5" Background="#BEC2CA" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale2" ScaleY="0.45" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="14" Margin="0,0,2,0" CornerRadius="1.5" Background="#E4E6EA" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale3" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="7" Margin="0,0,2,0" CornerRadius="1.5" Background="#AEB3BC" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale4" ScaleY="0.55" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="11" Margin="0,0,2,0" CornerRadius="1.5" Background="#D5D7DC" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale5" ScaleY="0.3" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="8" Margin="0,0,2,0" CornerRadius="1.5" Background="#B8BCC4" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale6" ScaleY="0.45" /></Border.RenderTransform>
                    </Border>
                    <Border Width="3" Height="13" CornerRadius="1.5" Background="#E1E3E7" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="WaveScale7" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="ProcessingContent"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <Control Width="22"
                         Height="22"
                         Focusable="False"
                         Template="{StaticResource Nyx.LogoMarkTemplate}" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Text="Traitement…"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="ProcessingDot1" Width="2.5" Height="2.5" Margin="0,0,2,0" Fill="{StaticResource Nyx.CyanBrush}" Opacity="0.25" />
                    <Ellipse x:Name="ProcessingDot2" Width="2.5" Height="2.5" Margin="0,0,2,0" Fill="{StaticResource Nyx.BlueBrush}" Opacity="0.25" />
                    <Ellipse x:Name="ProcessingDot3" Width="2.5" Height="2.5" Fill="{StaticResource Nyx.VioletBrush}" Opacity="0.25" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
