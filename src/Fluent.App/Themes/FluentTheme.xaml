<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monochrome (black & white) palette. -->
    <SolidColorBrush x:Key="Nyx.WindowBrush" Color="#060607" />
    <SolidColorBrush x:Key="Nyx.SidebarBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="Nyx.CardBrush" Color="#0E0E10" />
    <SolidColorBrush x:Key="Nyx.SelectedBrush" Color="#17171A" />
    <SolidColorBrush x:Key="Nyx.BorderBrush" Color="#2A2A2E" />
    <SolidColorBrush x:Key="Nyx.CapsuleBorderBrush" Color="#3E3E44" />
    <SolidColorBrush x:Key="Nyx.PrimaryTextBrush" Color="#F5F5F6" />
    <SolidColorBrush x:Key="Nyx.SecondaryTextBrush" Color="#9A9AA0" />
    <SolidColorBrush x:Key="Nyx.MutedTextBrush" Color="#6A6A70" />
    <!-- Accents collapse to white/grey so the interface stays black & white. -->
    <SolidColorBrush x:Key="Nyx.CyanBrush" Color="#F5F5F6" />
    <SolidColorBrush x:Key="Nyx.BlueBrush" Color="#C8C8CC" />
    <SolidColorBrush x:Key="Nyx.VioletBrush" Color="#8A8A90" />
    <SolidColorBrush x:Key="Nyx.SuccessBrush" Color="#F0F0F1" />
    <SolidColorBrush x:Key="Nyx.WarningBrush" Color="#C8C8CC" />
    <SolidColorBrush x:Key="Nyx.ErrorBrush" Color="#9A9AA0" />
    <!-- Subtle white-transparent navigation outlines (no solid visible border). -->
    <SolidColorBrush x:Key="Nyx.NavHoverOutlineBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="Nyx.NavActiveOutlineBrush" Color="#5CFFFFFF" />

    <LinearGradientBrush x:Key="Nyx.AccentGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#C8C8C8" Offset="0.4" />
        <GradientStop Color="#808080" Offset="0.72" />
        <GradientStop Color="#4A4A4A" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Nyx.PageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="Nyx.SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="Nyx.LabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.MutedTextBrush}" />
    </Style>

    <Style x:Key="Nyx.BodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.SecondaryTextBrush}" />
    </Style>

    <Style x:Key="Nyx.MetricTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="Nyx.DashboardCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Nyx.CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Sidebar navigation surface: no fixed border; outline on hover, and a
         stronger outline when active (set from code) or keyboard-focused. -->
    <Style x:Key="Nyx.NavSurfaceStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Nyx.NavHoverOutlineBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Focus outline for the navigation buttons (keyboard). -->
    <Style x:Key="Nyx.NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Nyx.LogoMarkTemplate" TargetType="{x:Type Control}">
        <Grid>
            <Border Background="{StaticResource Nyx.AccentGradientBrush}"
                    CornerRadius="9" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="2" Height="6" Margin="1,0" CornerRadius="1" Background="#0A0A0A" />
                <Border Width="2" Height="11" Margin="1,0" CornerRadius="1" Background="#0A0A0A" />
                <Border Width="2" Height="16" Margin="1,0" CornerRadius="1" Background="#000000" />
                <Border Width="2" Height="10" Margin="1,0" CornerRadius="1" Background="#0A0A0A" />
                <Border Width="2" Height="5" Margin="1,0" CornerRadius="1" Background="#0A0A0A" />
            </StackPanel>
            <Border BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="9" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
