<UserControl x:Class="Fluent.App.Views.DictionaryPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="840"
             mc:Ignorable="d"
             Background="{StaticResource Nyx.WindowBrush}"
             Foreground="{StaticResource Nyx.PrimaryTextBrush}"
             FontFamily="Segoe UI Variable Text"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="Dictionary.InputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Nyx.SelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Nyx.CyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Nyx.BlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Nyx.CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dictionary.PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Background" Value="{StaticResource Nyx.CyanBrush}" />
            <Setter Property="Foreground" Value="#06100F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dictionary.SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Background" Value="{StaticResource Nyx.SelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Nyx.SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Nyx.CyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dictionary.DeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource Dictionary.SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource Nyx.ErrorBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,26,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Dictionnaire"
                               Style="{StaticResource Nyx.PageTitleTextStyle}" />
                    <TextBlock Text="Gérez les corrections personnelles appliquées à la transcription."
                               Margin="0,6,0,0"
                               Style="{StaticResource Nyx.BodyTextStyle}" />
                </StackPanel>

                <Border x:Name="StorageBadgeBorder"
                        Grid.Column="1"
                        Margin="18,2,0,0"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="#141E8E89"
                        BorderBrush="#4D30D1CB"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StorageBadgeDot"
                                 Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource Nyx.CyanBrush}" />
                        <TextBlock x:Name="StorageBadgeTextBlock"
                                   Text="CHARGEMENT LOCAL"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nyx.CyanBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="14,12"
                    Background="#0E639BFA"
                    BorderBrush="#30639BFA"
                    BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="i"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Nyx.BlueBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="StorageDescriptionTextBlock"
                               Grid.Column="1"
                               Text="Initialisation du stockage local du dictionnaire. Aucun audio ni texte dicté n’est enregistré."
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Style="{StaticResource Nyx.BodyTextStyle}"
                               FontSize="11" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource Nyx.DashboardCardStyle}">
                <StackPanel x:Name="EditorPanel" IsEnabled="False">
                    <TextBlock Text="Ajouter une correction"
                               Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                    <TextBlock Text="La forme reconnue sera remplacée par le texte indiqué lors de la réécriture."
                               Margin="0,5,0,0"
                               Style="{StaticResource Nyx.BodyTextStyle}"
                               FontSize="11" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="FORME RECONNUE"
                                       Margin="1,0,0,7"
                                       Style="{StaticResource Nyx.LabelTextStyle}" />
                            <TextBox x:Name="SpokenFormTextBox"
                                     Style="{StaticResource Dictionary.InputStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REMPLACEMENT"
                                       Margin="1,0,0,7"
                                       Style="{StaticResource Nyx.LabelTextStyle}" />
                            <TextBox x:Name="ReplacementTextBox"
                                     Style="{StaticResource Dictionary.InputStyle}" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Margin="0,23,0,0"
                                Content="Ajouter / mettre à jour"
                                Click="AddOrUpdateButton_Click"
                                Style="{StaticResource Dictionary.PrimaryButtonStyle}" />
                    </Grid>

                    <TextBlock x:Name="MutationStatusText"
                               Margin="1,11,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Style="{StaticResource Nyx.DashboardCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Corrections locales"
                                       Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                            <TextBlock x:Name="EntryCountTextBlock"
                                       Text="Chargement du dictionnaire local"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource Nyx.BodyTextStyle}"
                                       FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="240">
                            <TextBlock Text="RECHERCHER"
                                       Margin="1,0,0,7"
                                       Style="{StaticResource Nyx.LabelTextStyle}" />
                            <TextBox x:Name="SearchTextBox"
                                     IsEnabled="False"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Style="{StaticResource Dictionary.InputStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <ItemsControl x:Name="EntriesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="13,11"
                                            Background="{StaticResource Nyx.SelectedBrush}"
                                            BorderBrush="{StaticResource Nyx.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="FORME RECONNUE"
                                                           Style="{StaticResource Nyx.LabelTextStyle}" />
                                                <TextBlock Text="{Binding SpokenForm}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="→"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Nyx.MutedTextBrush}"
                                                       FontSize="13" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="REMPLACEMENT"
                                                           Style="{StaticResource Nyx.LabelTextStyle}" />
                                                <TextBlock Text="{Binding Replacement}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Modifier"
                                                        Margin="0,0,7,0"
                                                        Tag="{Binding}"
                                                        Click="EditButton_Click"
                                                        Style="{StaticResource Dictionary.SecondaryButtonStyle}" />
                                                <Button Content="Supprimer"
                                                        Tag="{Binding}"
                                                        Click="DeleteButton_Click"
                                                        Style="{StaticResource Dictionary.DeleteButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyStateBorder"
                                Padding="18,24"
                                Background="{StaticResource Nyx.SelectedBrush}"
                                BorderBrush="{StaticResource Nyx.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyStateTitleTextBlock"
                                           Text="Chargement du dictionnaire"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                                           Text="Le stockage local est en cours d’initialisation."
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
