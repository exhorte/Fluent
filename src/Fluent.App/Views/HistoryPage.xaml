<UserControl x:Class="Fluent.App.Views.HistoryPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="840"
             mc:Ignorable="d"
             Background="{StaticResource Nyx.WindowBrush}"
             Foreground="{StaticResource Nyx.PrimaryTextBrush}"
             FontFamily="Segoe UI Variable Text"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="History.InputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Nyx.SelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Nyx.CyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Nyx.BlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Nyx.CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="History.PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Background" Value="{StaticResource Nyx.CyanBrush}" />
            <Setter Property="Foreground" Value="#06100F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="History.SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Background" Value="{StaticResource Nyx.SelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Nyx.SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Nyx.CyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="History.DeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource History.SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource Nyx.ErrorBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,26,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Historique"
                               Style="{StaticResource Nyx.PageTitleTextStyle}" />
                    <TextBlock Text="Historique local et optionnel de vos dictées. Aucun audio, aucun envoi externe."
                               Margin="0,6,0,0"
                               Style="{StaticResource Nyx.BodyTextStyle}" />
                </StackPanel>

                <Border x:Name="StateBadgeBorder"
                        Grid.Column="1"
                        Margin="18,2,0,0"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="{StaticResource Nyx.SelectedBrush}"
                        BorderBrush="{StaticResource Nyx.MutedTextBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateBadgeDot"
                                 Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource Nyx.MutedTextBrush}" />
                        <TextBlock x:Name="StateBadgeText"
                                   Text="DÉSACTIVÉ"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nyx.MutedTextBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource Nyx.DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Enregistrement de l’historique"
                                   Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                        <TextBlock Text="Désactivé par défaut. Lorsqu’il est activé, seul le texte final de vos dictées est enregistré, uniquement sur cet appareil. Aucun audio n’est jamais conservé et rien n’est envoyé à l’extérieur. Les 500 entrées les plus récentes sont conservées ; vous pouvez supprimer une entrée ou tout effacer à tout moment."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Style="{StaticResource Nyx.BodyTextStyle}"
                                   FontSize="11" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,11,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   FontSize="10" />
                    </StackPanel>

                    <Button x:Name="ToggleButton"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Content="Activer l’historique"
                            Click="ToggleButton_Click"
                            Style="{StaticResource History.PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource Nyx.DashboardCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dictées enregistrées"
                                       Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                            <TextBlock x:Name="EntryCountTextBlock"
                                       Text="Aucune dictée enregistrée"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource Nyx.BodyTextStyle}"
                                       FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Center">
                            <TextBlock Text="RECHERCHER"
                                       Margin="1,0,0,7"
                                       Style="{StaticResource Nyx.LabelTextStyle}" />
                            <TextBox x:Name="SearchTextBox"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Style="{StaticResource History.InputStyle}" />
                        </StackPanel>

                        <Button x:Name="ClearButton"
                                Grid.Column="3"
                                Margin="0,23,0,0"
                                VerticalAlignment="Center"
                                Content="Tout effacer"
                                Click="ClearButton_Click"
                                Style="{StaticResource History.DeleteButtonStyle}" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <ItemsControl x:Name="EntriesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="13,11"
                                            Background="{StaticResource Nyx.SelectedBrush}"
                                            BorderBrush="{StaticResource Nyx.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time}"
                                                               Foreground="{StaticResource Nyx.MutedTextBrush}"
                                                               FontFamily="Cascadia Mono"
                                                               FontSize="9" />
                                                    <TextBlock Text="{Binding Profile}"
                                                               Margin="10,0,0,0"
                                                               Foreground="{StaticResource Nyx.CyanBrush}"
                                                               FontFamily="Cascadia Mono"
                                                               FontSize="9" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Nyx.PrimaryTextBrush}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Content="Supprimer"
                                                    Tag="{Binding}"
                                                    Click="DeleteButton_Click"
                                                    Style="{StaticResource History.DeleteButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyStateBorder"
                                Padding="18,24"
                                Background="{StaticResource Nyx.SelectedBrush}"
                                BorderBrush="{StaticResource Nyx.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyStateTitleTextBlock"
                                           Text="Historique désactivé"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                <TextBlock x:Name="EmptyStateDescriptionTextBlock"
                                           Text="Activez l’historique pour enregistrer localement le texte de vos prochaines dictées."
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Nyx.BodyTextStyle}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
