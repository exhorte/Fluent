<UserControl x:Class="Fluent.App.Views.ProfilesPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="840"
             mc:Ignorable="d"
             Background="{StaticResource Nyx.WindowBrush}"
             Foreground="{StaticResource Nyx.PrimaryTextBrush}"
             FontFamily="Segoe UI Variable Text"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="Profiles.SelectButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="{StaticResource Nyx.SelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Nyx.SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nyx.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Nyx.CyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Nyx.PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,26,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding [profiles.title], Source={StaticResource Loc}}"
                               Style="{StaticResource Nyx.PageTitleTextStyle}" />
                    <TextBlock Text="{Binding [profiles.subtitle], Source={StaticResource Loc}}"
                               Margin="0,6,0,0"
                               Style="{StaticResource Nyx.BodyTextStyle}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="18,2,0,0"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="#141E8E89"
                        BorderBrush="#4D30D1CB"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource Nyx.CyanBrush}" />
                        <TextBlock Text="{Binding [profiles.sessionBadge], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nyx.CyanBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="14,12"
                    Background="#0E639BFA"
                    BorderBrush="#30639BFA"
                    BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="i"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Nyx.BlueBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding [profiles.info], Source={StaticResource Loc}}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Style="{StaticResource Nyx.BodyTextStyle}"
                               FontSize="11" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <ItemsControl x:Name="ProfilesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Style="{StaticResource Nyx.DashboardCardStyle}"
                                    Opacity="{Binding CardOpacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                                            <Border Margin="10,0,0,0"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding BadgeBackground}"
                                                    BorderBrush="{Binding BadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeForeground}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   Style="{StaticResource Nyx.BodyTextStyle}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding UnavailableReasonVisibility}"
                                                   Foreground="{StaticResource Nyx.MutedTextBrush}"
                                                   FontSize="10" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            MinWidth="110"
                                            Content="{Binding ActionText}"
                                            IsEnabled="{Binding IsActionEnabled}"
                                            Tag="{Binding Id}"
                                            Click="SelectButton_Click"
                                            Style="{StaticResource Profiles.SelectButtonStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="SelectionStatusText"
                           Margin="1,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           FontSize="10" />
            </StackPanel>

            <Border Grid.Row="6" Style="{StaticResource Nyx.DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [profiles.auth.title], Source={StaticResource Loc}}"
                                       Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                            <Border x:Name="AuthenticationBadgeBorder"
                                    Margin="10,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Nyx.SelectedBrush}"
                                    BorderBrush="{StaticResource Nyx.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock x:Name="AuthenticationBadgeText"
                                           Text="MODE LOCAL"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Nyx.MutedTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="AuthenticationStatusText"
                                   Text="Authentification non configurée ; le mode local reste actif."
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Style="{StaticResource Nyx.BodyTextStyle}"
                                   FontSize="11" />
                        <StackPanel x:Name="AuthenticatedUserPanel"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="AuthenticatedUserNameText"
                                       Foreground="{StaticResource Nyx.SecondaryTextBrush}"
                                       FontSize="10" />
                            <TextBlock x:Name="AuthenticatedUserEmailText"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource Nyx.MutedTextBrush}"
                                       FontFamily="Cascadia Mono"
                                       FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="AuthenticationActionButton"
                                MinWidth="126"
                                Content="Se connecter avec Google"
                                Click="AuthenticationActionButton_Click"
                                Style="{StaticResource Profiles.SelectButtonStyle}" />
                        <Button x:Name="AuthenticationCancelButton"
                                Margin="8,0,0,0"
                                MinWidth="74"
                                Content="Annuler"
                                Visibility="Collapsed"
                                Click="AuthenticationCancelButton_Click"
                                Style="{StaticResource Profiles.SelectButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource Nyx.DashboardCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [profiles.cloud.title], Source={StaticResource Loc}}"
                                       Style="{StaticResource Nyx.SectionTitleTextStyle}" />
                            <Border x:Name="CloudBadgeBorder"
                                    Margin="10,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Nyx.SelectedBrush}"
                                    BorderBrush="{StaticResource Nyx.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock x:Name="CloudBadgeText"
                                           Text="MODE LOCAL"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Nyx.MutedTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="CloudStatusText"
                                   Text="Le mode local est utilisé. Aucune donnée n'est envoyée sur Internet."
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Style="{StaticResource Nyx.BodyTextStyle}"
                                   FontSize="11" />
                        <TextBlock x:Name="CloudConsentText"
                                   Text="Le premier usage Cloud demande votre consentement explicite. L'audio reste toujours local."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Nyx.MutedTextBrush}"
                                   FontSize="10" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <Button x:Name="CloudToggleButton"
                                MinWidth="164"
                                Content="Activer le Cloud"
                                Click="CloudToggleButton_Click"
                                Style="{StaticResource Profiles.SelectButtonStyle}" />
                        <StackPanel Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="GeminiProviderButton"
                                    MinWidth="76"
                                    Margin="0,0,6,0"
                                    Tag="gemini"
                                    Content="Gemini · actif"
                                    Click="ProviderSelectionButton_Click"
                                    Style="{StaticResource Profiles.SelectButtonStyle}" />
                            <Button x:Name="DeepSeekProviderButton"
                                    MinWidth="104"
                                    Tag="deepseek"
                                    Content="DeepSeek V4 Pro"
                                    Click="ProviderSelectionButton_Click"
                                    Style="{StaticResource Profiles.SelectButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
